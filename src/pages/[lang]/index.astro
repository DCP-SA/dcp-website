---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import SecurityArchitecture from '../../components/SecurityArchitecture.astro'; // New component for ZK/ECIES
import Footer from '../../components/Footer.astro';
import AuthModal from '../../components/AuthModal.astro';
import { getLangFromUrl, languages } from '../../i18n/utils';
import TheebanShowcase from '../../components/TheebanShowcase.astro';
import MaasDeployerTeaser from '../../components/MaasDeployerTeaser.astro';
import ApiDevelopers from '../../components/ApiDevelopers.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
---

<Layout title="DCP | AI Infrastructure & Zero-Knowledge Chat" lang=`${lang}`>
  <Header />
  <main class="flex-1 overflow-x-hidden">
    <Hero />
    <TheebanShowcase /> 
    <MaasDeployerTeaser />
    <ApiDevelopers />
    <SecurityArchitecture />
  </main>
  <Footer />
  <AuthModal />
</Layout>